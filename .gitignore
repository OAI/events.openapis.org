# Dependencies
/node_modules

# Next.js
/.next/
/out/
# Regenerated by every `next dev` / `next build`. Since Next 16 splits dev and
# build output, it points at .next/dev/types or .next/types depending on which
# ran last, so tracking it only produces churn.
next-env.d.ts
next-env.d.ts.bak

# Cloudflare (OpenNext adapter) build output + local state
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# TypeScript
*.tsbuildinfo

# Raw source images (inbox for the convert-image skill; only the converted
# WebP under public/img/ is committed)
/source-images/

# Speaker images published from data/ by `npm run speakers` (build artifacts —
# the source of truth is data/speakers/image/ and data/**/speakers/image/).
# Regenerated on predev/prebuild; never committed.
/public/img/speakers/
/public/img/events/*/speakers/

# Event cover images published from data/ by `npm run covers` (build artifacts —
# the source of truth is data/<year>/<slug>/images/cover*). The generated
# manifest data/covers.generated.yml IS committed, so a fresh clone can
# typecheck before any pre-hook has run.
/public/img/events/*/cover.*

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Design reference exports (Figma), not part of the build
__design/

dev-assets/
# Flat cover export produced by `npm run covers:export` (a handoff artifact;
# the source of truth stays in data/<year>/<slug>/images/).
/covers-export/

# Playwright run artifacts (traces/screenshots on failure, and the HTML report
# if one is requested — the configured reporter is 'list').
/test-results/
/playwright-report/
